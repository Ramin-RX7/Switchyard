{
  "listen": ":8091",
  "backends": [
    { "url": "http://127.0.0.1:9001" },
    { "id": "secondary", "url": "http://127.0.0.1:9002" }
  ],
  "set_headers": {
    "X-Real-IP": "$remote_addr",
    "X-Forwarded-Proto": "$scheme",
    "X-Forwarded-Host": "$host",
    "X-Origin-URL": "$http_origin"
  },
  "logging": {
    "outputs": ["console", "file"],
    "file": "switchyard.log",
    "format": "{receive_time} {method} {url} backend={backend_id} ip={var.remote_addr} origin={var.http_origin} status={status} dur={request_duration}"
  }
}
